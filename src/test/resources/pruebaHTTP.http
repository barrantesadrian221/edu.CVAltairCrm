@baseUrl = http://localhost:8080

### =================================================================== ###
### PRUEBAS DE ALUMNOS (API REST)
### =================================================================== ###

### 1. Crear un nuevo alumno -> Esperado: 201 Created
# @name crearAlumno
POST {{baseUrl}}/api/alumnos
Content-Type: application/json

{
  "dni": "12345678A",
  "nombre": "Carlos",
  "apellidos": "García Martínez",
  "email": "carlos.garcia@altair.edu",
  "numeroSeguridadSocial": "281234567840",
  "fechaNacimiento": "2002-05-14",
  "tutorialCompletado": false
}

### 2. Listar todos los alumnos -> Esperado: 200 OK
GET {{baseUrl}}/api/alumnos

### 3. Buscar alumno por ID -> Esperado: 200 OK
GET {{baseUrl}}/api/alumnos/{{crearAlumno.response.body.$.idAlumno}}

### 4. Buscar alumno por DNI -> Esperado: 200 OK
GET {{baseUrl}}/api/alumnos/dni/{{crearAlumno.response.body.$.dni}}

### 5. Buscar alumno por email -> Esperado: 200 OK
GET {{baseUrl}}/api/alumnos/email/{{crearAlumno.response.body.$.email}}

### 6. Buscar alumno por número de seguridad social -> Esperado: 200 OK
GET {{baseUrl}}/api/alumnos/nss/{{crearAlumno.response.body.$.numeroSeguridadSocial}}

### 7. Probar colisión por DNI duplicado -> Esperado: 409 Conflict
POST {{baseUrl}}/api/alumnos
Content-Type: application/json

{
  "dni": "{{crearAlumno.response.body.$.dni}}",
  "nombre": "Otro Nombre",
  "apellidos": "Pérez",
  "email": "otro.email@altair.edu",
  "numeroSeguridadSocial": "999999999999",
  "fechaNacimiento": "2001-01-01",
  "tutorialCompletado": false
}

### 8. Actualizar alumno por ID -> Esperado: 200 OK
PUT {{baseUrl}}/api/alumnos/{{crearAlumno.response.body.$.idAlumno}}
Content-Type: application/json

{
  "dni": "{{crearAlumno.response.body.$.dni}}",
  "nombre": "Carlos Manuel",
  "apellidos": "García Martínez",
  "email": "{{crearAlumno.response.body.$.email}}",
  "numeroSeguridadSocial": "{{crearAlumno.response.body.$.numeroSeguridadSocial}}",
  "fechaNacimiento": "2002-05-14",
  "tutorialCompletado": true
}

### 9. Actualizar alumno por DNI -> Esperado: 200 OK
PUT {{baseUrl}}/api/alumnos/dni/{{crearAlumno.response.body.$.dni}}
Content-Type: application/json

{
  "dni": "{{crearAlumno.response.body.$.dni}}",
  "nombre": "Carlos Manuel",
  "apellidos": "García Martínez Modificado",
  "email": "{{crearAlumno.response.body.$.email}}",
  "numeroSeguridadSocial": "{{crearAlumno.response.body.$.numeroSeguridadSocial}}",
  "fechaNacimiento": "2002-05-14",
  "tutorialCompletado": true
}

### =================================================================== ###
### PRUEBAS DE EXPERIENCIAS LABORALES (API REST)
### =================================================================== ###

### 10. Crear experiencia para el alumno creado -> Esperado: 201 Created
# @name crearExperiencia
POST {{baseUrl}}/api/experiencias/alumno/{{crearAlumno.response.body.$.idAlumno}}
Content-Type: application/json

{
  "puesto": "Desarrollador Web Frontend (Prácticas)",
  "empresa": "Tech Solutions S.L.",
  "periodo": "JUN 2026 - SEP 2026",
  "descripcion": "Maquetación HTML/CSS y JavaScript en proyecto CRM"
}

### 11. Listar experiencias del alumno -> Esperado: 200 OK
GET {{baseUrl}}/api/experiencias/alumno/{{crearAlumno.response.body.$.idAlumno}}

### 12. Actualizar experiencia por ID -> Esperado: 200 OK
PUT {{baseUrl}}/api/experiencias/{{crearExperiencia.response.body.$.idExperiencia}}
Content-Type: application/json

{
  "puesto": "Desarrollador Web Full Stack",
  "empresa": "Tech Solutions S.L.",
  "periodo": "JUN 2026 - DIC 2026",
  "descripcion": "Desarrollo completo con Spring Boot y frontend"
}

### =================================================================== ###
### PRUEBAS DE CV Y SUS RELACIONES (API REST)
### =================================================================== ###

### 13. Crear formación para el alumno -> Esperado: 201 Created
# @name crearFormacion
POST {{baseUrl}}/api/formaciones/alumno/{{crearAlumno.response.body.$.idAlumno}}
Content-Type: application/json

{
  "titulo": "Desarrollo de Aplicaciones Web",
  "centro": "Centro Educativo Altair",
  "periodo": "2023 - 2025",
  "enCurso": false
}

### 14. Crear habilidad para el alumno -> Esperado: 201 Created
# @name crearHabilidad
POST {{baseUrl}}/api/habilidades/alumno/{{crearAlumno.response.body.$.idAlumno}}
Content-Type: application/json

{
  "nombre": "Java",
  "descripcion": "Desarrollo de aplicaciones backend",
  "destacada": true
}

### 15. Crear idioma para el alumno -> Esperado: 201 Created
# @name crearIdioma
POST {{baseUrl}}/api/idiomas/alumno/{{crearAlumno.response.body.$.idAlumno}}
Content-Type: application/json

{
  "nombre": "Inglés",
  "nivel": "C1"
}

### 16. Crear certificación para el alumno -> Esperado: 201 Created
# @name crearCertificacion
POST {{baseUrl}}/api/certificaciones/alumno/{{crearAlumno.response.body.$.idAlumno}}
Content-Type: application/json

{
  "titulo": "AWS Cloud Practitioner",
  "emision": "Amazon Web Services",
  "fechaObtencion": "2025-06-20"
}

### 17. Crear CV vinculado a los elementos del alumno -> Esperado: 201 Created
# @name crearCv
POST {{baseUrl}}/api/cvs/alumno/{{crearAlumno.response.body.$.idAlumno}}
Content-Type: application/json

{
  "idsExperiencias": [{{crearExperiencia.response.body.$.idExperiencia}}],
  "idsFormaciones": [{{crearFormacion.response.body.$.idFormacion}}],
  "idsHabilidades": [{{crearHabilidad.response.body.$.idHabilidadTecnica}}],
  "idsIdiomas": [{{crearIdioma.response.body.$.idIdioma}}],
  "idsCertificaciones": [{{crearCertificacion.response.body.$.idCertificacion}}],
  "ordenBloques": [
    { "tipo": "EXPERIENCIA", "idElemento": {{crearExperiencia.response.body.$.idExperiencia}} },
    { "tipo": "FORMACION", "idElemento": {{crearFormacion.response.body.$.idFormacion}} },
    { "tipo": "HABILIDAD", "idElemento": {{crearHabilidad.response.body.$.idHabilidadTecnica}} },
    { "tipo": "IDIOMA", "idElemento": {{crearIdioma.response.body.$.idIdioma}} },
    { "tipo": "CERTIFICACION", "idElemento": {{crearCertificacion.response.body.$.idCertificacion}} }
  ]
}

### 18. Consultar CV por ID -> Esperado: 200 OK
GET {{baseUrl}}/api/cvs/{{crearCv.response.body.$.idCV}}

### 19. Consultar CV por alumno -> Esperado: 200 OK
GET {{baseUrl}}/api/cvs/alumno/{{crearAlumno.response.body.$.idAlumno}}

### 20. Filtrar CV por certificación, habilidad e idioma+nivel -> Esperado: 200 OK
POST {{baseUrl}}/api/cvs/buscar
Content-Type: application/json

{
  "certificacion": "AWS Cloud Practitioner",
  "habilidad": "Java",
  "idioma": "Inglés",
  "nivelIdioma": "C1"
}

### 21. Reemplazar contenido del CV y quitar su experiencia -> Esperado: 200 OK
PUT {{baseUrl}}/api/cvs/{{crearCv.response.body.$.idCV}}
Content-Type: application/json

{
  "idsExperiencias": [],
  "idsFormaciones": [{{crearFormacion.response.body.$.idFormacion}}],
  "idsHabilidades": [{{crearHabilidad.response.body.$.idHabilidadTecnica}}],
  "idsIdiomas": [{{crearIdioma.response.body.$.idIdioma}}],
  "idsCertificaciones": [{{crearCertificacion.response.body.$.idCertificacion}}],
  "ordenBloques": [
    { "tipo": "CERTIFICACION", "idElemento": {{crearCertificacion.response.body.$.idCertificacion}} },
    { "tipo": "IDIOMA", "idElemento": {{crearIdioma.response.body.$.idIdioma}} },
    { "tipo": "HABILIDAD", "idElemento": {{crearHabilidad.response.body.$.idHabilidadTecnica}} },
    { "tipo": "FORMACION", "idElemento": {{crearFormacion.response.body.$.idFormacion}} }
  ]
}

### 22. Volver a consultar CV y comprobar que experiencias está vacío -> Esperado: 200 OK
GET {{baseUrl}}/api/cvs/{{crearCv.response.body.$.idCV}}

### 23. Eliminar CV -> Esperado: 204 No Content
DELETE {{baseUrl}}/api/cvs/{{crearCv.response.body.$.idCV}}

### 24. Eliminar experiencia -> Esperado: 204 No Content
DELETE {{baseUrl}}/api/experiencias/{{crearExperiencia.response.body.$.idExperiencia}}

### 25. Eliminar formación -> Esperado: 204 No Content
DELETE {{baseUrl}}/api/formaciones/{{crearFormacion.response.body.$.idFormacion}}

### 26. Eliminar habilidad -> Esperado: 204 No Content
DELETE {{baseUrl}}/api/habilidades/{{crearHabilidad.response.body.$.idHabilidadTecnica}}

### 27. Eliminar idioma -> Esperado: 204 No Content
DELETE {{baseUrl}}/api/idiomas/{{crearIdioma.response.body.$.idIdioma}}

### 28. Eliminar certificación -> Esperado: 204 No Content
DELETE {{baseUrl}}/api/certificaciones/{{crearCertificacion.response.body.$.idCertificacion}}

### 29. Eliminar alumno por ID -> Esperado: 204 No Content
DELETE {{baseUrl}}/api/alumnos/{{crearAlumno.response.body.$.idAlumno}}
